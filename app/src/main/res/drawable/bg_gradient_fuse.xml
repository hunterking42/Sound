<?xml version="1.0" encoding="utf-8"?>
<!-- Violet to spark, top-left to bottom-right (CSS 135deg = Android angle 315) -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient android:angle="315" android:startColor="@color/violet" android:endColor="@color/spark"/>
    <corners android:radius="28dp"/>
</shape>
