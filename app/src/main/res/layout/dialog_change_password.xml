<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_key"
        android:tint="@color/violet"
        android:importantForAccessibility="no"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="sans-serif-black"
        android:text="@string/pw_title"
        android:textColor="@color/cream"
        android:textSize="20sp"/>

    <LinearLayout
        android:id="@+id/boxCurrent"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_input"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp">
        <EditText
            android:id="@+id/inputCurrent"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/pw_current"
            android:inputType="textPassword"
            android:maxLines="1"
            android:textColor="@color/cream"
            android:textColorHint="@color/mist"
            android:textSize="15sp"/>
        <ImageView
            android:id="@+id/eyeCurrent"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_eye_off"
            android:tint="@color/mist"
            android:contentDescription="@string/cd_show_password"
            android:background="?attr/selectableItemBackgroundBorderless"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/boxNew"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_input"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp">
        <EditText
            android:id="@+id/inputNew"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/pw_new"
            android:inputType="textPassword"
            android:maxLines="1"
            android:textColor="@color/cream"
            android:textColorHint="@color/mist"
            android:textSize="15sp"/>
        <ImageView
            android:id="@+id/eyeNew"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_eye_off"
            android:tint="@color/mist"
            android:contentDescription="@string/cd_show_password"
            android:background="?attr/selectableItemBackgroundBorderless"/>
    </LinearLayout>

    <TextView
        android:id="@+id/errorMsg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/danger"
        android:textSize="12sp"
        android:visibility="gone"/>

    <Button
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_gradient_fuse"
        android:fontFamily="sans-serif-medium"
        android:text="@string/pw_save"
        android:textAllCaps="false"
        android:textColor="@color/on_fuse"
        android:textSize="15sp"/>
    <Button
        android:id="@+id/btnCancel"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_button_secondary"
        android:fontFamily="sans-serif-medium"
        android:text="@string/pw_cancel"
        android:textAllCaps="false"
        android:textColor="@color/cream"
        android:textSize="15sp"/>
</LinearLayout>
