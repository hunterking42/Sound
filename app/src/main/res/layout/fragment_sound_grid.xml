<?xml version="1.0" encoding="utf-8"?>
<!-- Shared by Home, Category and Favorites -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/offlineBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/plum"
        android:gravity="center"
        android:padding="8dp"
        android:text="@string/offline_banner"
        android:textColor="@color/volt"
        android:textSize="12sp"
        android:visibility="gone"/>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="8dp"
            android:visibility="gone"/>

        <ProgressBar
            android:id="@+id/loading"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/volt"/>

        <LinearLayout
            android:id="@+id/stateGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">
            <!-- Placeholder illustration: swap for the SVG empty-state art -->
            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_wave"
                android:tint="@color/plum_light"
                android:importantForAccessibility="no"/>
            <TextView
                android:id="@+id/stateText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textColor="@color/mist"
                android:textSize="15sp"/>
            <Button
                android:id="@+id/stateButton"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:minWidth="160dp"
                android:background="@drawable/bg_gradient_fuse"
                android:fontFamily="sans-serif-medium"
                android:text="@string/btn_try_again"
                android:textAllCaps="false"
                android:textColor="@color/on_fuse"
                android:textSize="15sp"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
