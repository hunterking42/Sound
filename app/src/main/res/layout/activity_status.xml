<?xml version="1.0" encoding="utf-8"?>
<!-- Shared by BlockedActivity and MaintenanceActivity -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:importantForAccessibility="no"/>

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:fontFamily="sans-serif-black"
        android:textColor="@color/cream"
        android:textSize="28sp"/>

    <TextView
        android:id="@+id/message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:textColor="@color/mist"
        android:textSize="15sp"/>

    <Button
        android:id="@+id/btnCheck"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_gradient_fuse"
        android:fontFamily="sans-serif-medium"
        android:text="@string/btn_check_again"
        android:textAllCaps="false"
        android:textColor="@color/on_fuse"
        android:textSize="15sp"/>

    <Button
        android:id="@+id/btnExit"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_button_secondary"
        android:fontFamily="sans-serif-medium"
        android:text="@string/btn_exit"
        android:textAllCaps="false"
        android:textColor="@color/cream"
        android:textSize="15sp"/>
</LinearLayout>
