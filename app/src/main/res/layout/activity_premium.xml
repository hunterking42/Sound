<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="8dp"
        android:padding="12dp"
        android:src="@drawable/ic_back"
        android:tint="@color/cream"
        android:contentDescription="@string/cd_back"
        android:background="?attr/selectableItemBackgroundBorderless"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_crown"
                android:tint="@color/gold"
                android:importantForAccessibility="no"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:fontFamily="sans-serif-black"
                android:text="@string/premium_title"
                android:textColor="@color/cream"
                android:textSize="28sp"/>
            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/gold"
                android:textSize="15sp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_crown"
                    android:drawablePadding="12dp"
                    android:drawableTint="@color/gold"
                    android:gravity="center_vertical"
                    android:text="@string/premium_benefit_1"
                    android:textColor="@color/cream"
                    android:textSize="15sp"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:drawableStart="@drawable/ic_crown"
                    android:drawablePadding="12dp"
                    android:drawableTint="@color/gold"
                    android:gravity="center_vertical"
                    android:text="@string/premium_benefit_2"
                    android:textColor="@color/cream"
                    android:textSize="15sp"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnBuy"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_gradient_fuse"
                android:drawableStart="@drawable/ic_send"
                android:drawableTint="@color/on_fuse"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="24dp"
                android:paddingEnd="48dp"
                android:textAllCaps="false"
                android:textColor="@color/on_fuse"
                android:textSize="15sp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
