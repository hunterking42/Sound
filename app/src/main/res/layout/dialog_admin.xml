<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:id="@+id/dlgIcon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:importantForAccessibility="no"/>
    <TextView
        android:id="@+id/dlgTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="sans-serif-black"
        android:textColor="@color/cream"
        android:textSize="20sp"/>
    <TextView
        android:id="@+id/dlgMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/mist"
        android:textIsSelectable="true"
        android:textSize="15sp"/>

    <LinearLayout
        android:id="@+id/dlgInputBox"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_input"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:visibility="gone">
        <EditText
            android:id="@+id/dlgInput"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:maxLines="1"
            android:textColor="@color/cream"
            android:textColorHint="@color/mist"
            android:textSize="15sp"/>
    </LinearLayout>
    <TextView
        android:id="@+id/dlgError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/danger"
        android:textSize="12sp"
        android:visibility="gone"/>

    <Button
        android:id="@+id/dlgPrimary"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"
        android:fontFamily="sans-serif-medium"
        android:textAllCaps="false"
        android:textColor="@color/on_fuse"
        android:textSize="15sp"/>
    <Button
        android:id="@+id/dlgNeutral"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_button_secondary"
        android:fontFamily="sans-serif-medium"
        android:textAllCaps="false"
        android:textColor="@color/cream"
        android:textSize="15sp"
        android:visibility="gone"/>
    <Button
        android:id="@+id/dlgCancel"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_button_secondary"
        android:fontFamily="sans-serif-medium"
        android:text="@string/btn_cancel"
        android:textAllCaps="false"
        android:textColor="@color/cream"
        android:textSize="15sp"/>
</LinearLayout>
