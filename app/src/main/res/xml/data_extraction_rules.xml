<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: no cloud backup and no device-to-device copy. The token is encrypted with a key that
     only exists on this phone, so a restored copy would be useless and could crash the app. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
    </device-transfer>
</data-extraction-rules>
