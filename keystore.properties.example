# Copy to keystore.properties (git-ignored) and fill in. Needed for signed release builds.
# Create the keystore once:  keytool -genkey -v -keystore soundbomb-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias soundbomb
storeFile=/absolute/path/to/soundbomb-release.jks
storePassword=CHANGE_ME
keyAlias=soundbomb
keyPassword=CHANGE_ME
